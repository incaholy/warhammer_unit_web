# Base URL of the warhammer_unit backend API (build-time, baked into the bundle).
#
# Empty or unset = same origin — used in local dev (the Vite proxy makes the API
# same-origin) and any same-domain deploy.
#
# For a cross-origin deploy (e.g. Firebase-hosted frontend -> Cloud Run backend),
# set the full API origin, no trailing slash:
#   VITE_API_BASE_URL=https://your-backend.run.app
VITE_API_BASE_URL=
